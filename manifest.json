{
  "manifest_version": 3,
  "name": "Criteria Catcher",
  "version": "1.3.0",
  "description": "Catch a task page into JSON, or fill its criteria back in one at a time.",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Criteria Catcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" }
}
