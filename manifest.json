{
  "manifest_version": 3,
  "name": "Criteria Catcher",
  "version": "1.1.0",
  "description": "Catch a task page into JSON, or fill its criteria back in one at a time.",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "action": { "default_title": "Criteria Catcher" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" }
}
